---
import Layout from '../layouts/Layout.astro';
import EmptyState from '../components/EmptyState.astro';
import { experience } from '../data/profile';
const categories = ['Research', 'Teaching', 'Service'] as const;
---
<Layout title="Experience"><div id="top"></div><section class="shell page-heading"><h1>Experience</h1></section><section class="shell content-section">{experience.length ? categories.map(category => { const entries = experience.filter(item => item.category === category); return entries.length > 0 && <div class="experience-group"><h2>{category === 'Service' ? 'Service' : category === 'Teaching' ? 'Teaching' : 'Research experience'}</h2>{entries.map(item => <article class="timeline-entry"><span class="entry-meta">{item.period}</span><div><h3>{item.title}</h3><p class="organization">{item.organization}</p><p>{item.description}</p></div></article>)}</div>; }) : <EmptyState title="The journey, in more detail." text="Research roles, teaching, mentorship, and service will be collected here as background details are added." />}</section></Layout>
