---
import Layout from '../layouts/Layout.astro';
import Spheres from '../components/Spheres.astro';
import Icon from '../components/Icon.astro';
import { profile, education } from '../data/profile';
import { local } from '../lib/paths';
---
<Layout title="About"><div id="top"></div><section class="shell page-heading"><p class="eyebrow">A LITTLE CONTEXT</p><h1>Behind the questions<span class="muted-period">.</span></h1><p>My background, interests, and the path toward doctoral study.</p></section><section class="shell about-layout section-block"><div class="about-visual">{profile.portrait ? <img src={local(profile.portrait)} alt={profile.name} width="800" height="800" /> : <Spheres compact />}<div class="identity-caption"><h2>{profile.name}</h2><p>{profile.role}</p>{profile.affiliation && <p>{profile.affiliation}</p>}{profile.location && <p>{profile.location}</p>}</div></div><div class="prose"><p class="eyebrow">HELLO, I’M PORTER</p>{profile.bio.map(paragraph => <p>{paragraph}</p>)}{profile.interests.length > 0 && <div class="prose-section"><h2>What interests me</h2><div class="flex flex-wrap gap-2">{profile.interests.map(interest => <span class="pill">{interest}</span>)}</div></div>}{education.length > 0 && <div class="prose-section"><h2>Education</h2>{education.map(item => <article class="education-item"><span class="entry-meta">{item.period}</span><h3>{item.degree}</h3><p>{item.institution}</p>{item.detail && <p class="small-copy">{item.detail}</p>}</article>)}</div>}<a class="text-link" href={local('cv/')}>View my curriculum vitae <Icon /></a></div></section></Layout>
