---
import Layout from '../layouts/Layout.astro';
import { profile, education, publications, updates } from '../data/profile';
import { local, resolveLink } from '../lib/paths';
---
<Layout>
  <div id="top"></div>
  <section class="shell academic-intro">
    <div class="academic-bio">
      <h1>{profile.name}</h1>
      <p class="academic-role">{profile.role}</p>
      <p>{profile.introduction}</p>
      <p>Previously, I studied economics at Brigham Young University, with minors in mathematics and Chinese. My research experience includes empirical economics, asset pricing, and machine learning.</p>
      <div class="academic-links">
        {profile.email && <a href={`mailto:${profile.email}`}>Email</a>}
        <a href={local('cv/')}>CV</a>
        <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        {profile.linkedin && <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>}
      </div>
    </div>
    {profile.portrait && <img class="home-portrait" src={local(profile.portrait)} alt={profile.name} width="800" height="800" />}
  </section>
  <section class="shell academic-section">
    <h2>Research interests</h2>
    <div><ul class="interest-list">{profile.interests.map(interest => <li>{interest}</li>)}</ul><a class="text-link" href={local('research/')}>Research projects</a></div>
  </section>
  {publications.length > 0 && <section class="shell academic-section">
    <h2>Papers</h2>
    <div class="home-papers">{[...publications].sort((a,b) => b.year - a.year).map(paper => <article>
      <h3>{paper.url ? <a href={resolveLink(paper.url)} target="_blank" rel="noopener noreferrer">{paper.title}</a> : paper.title}</h3>
      <p>{paper.authors} · {paper.year}</p><p class="small-copy">{paper.type}</p><a class="text-link" href={local('publications/')}>Abstract and paper</a>
    </article>)}</div>
  </section>}
  {education.length > 0 && <section class="shell academic-section">
    <h2>Education</h2>
    <div>{education.map(item => <article class="home-education"><h3>{item.degree}</h3><p>{item.institution}, {item.period}</p></article>)}</div>
  </section>}
  {updates.length > 0 && <section class="shell academic-section">
    <h2>News</h2>
    <div>{updates.map(update => <article class="update-entry"><time datetime={update.date}>{new Date(`${update.date}T12:00:00`).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</time><p>{update.url ? <a href={update.url}>{update.text}</a> : update.text}</p></article>)}</div>
  </section>}
</Layout>
