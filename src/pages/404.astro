---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { local } from '../lib/paths';
---
<Layout title="Page not found"><div id="top"></div><section class="shell page-heading not-found"><p class="eyebrow">404 / A SMALL DETOUR</p><h1>A question mark<span class="muted-period">.</span></h1><p>This page doesn’t exist. Let’s get you back to familiar ground.</p><a class="button button-dark mt-8" href={local()}>Back to home <Icon /></a></section></Layout>
