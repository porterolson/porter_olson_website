---
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/profile';
const socials = [['GitHub', profile.github], ['Google Scholar', profile.scholar], ['ORCID', profile.orcid], ['LinkedIn', profile.linkedin]].filter(([,url]) => url);
---
<Layout title="Contact">
  <div id="top"></div>
  <section class="shell page-heading"><h1>Contact</h1></section>
  <section class="shell content-section contact-details">
    <p>{profile.name}</p><p>Finance department</p><p>NYU Stern School of Business</p>
    {profile.location && <p>{profile.location}</p>}
    {profile.email && <p class="contact-address"><a href={`mailto:${profile.email}`}>{profile.email}</a></p>}
    <div class="academic-links">{socials.map(([label,url]) => <a href={url} target="_blank" rel="noopener noreferrer">{label}</a>)}</div>
  </section>
</Layout>
