---
import Layout from '../layouts/Layout.astro';
import EmptyState from '../components/EmptyState.astro';
import Icon from '../components/Icon.astro';
import { publications } from '../data/profile';
import { resolveLink } from '../lib/paths';
const sorted = [...publications].sort((a, b) => b.year - a.year);
const years = [...new Set(sorted.map(item => item.year))];
---
<Layout title="Publications"><div id="top"></div><section class="shell page-heading"><p class="eyebrow">WRITING & CONTRIBUTIONS</p><h1>Publications<span class="muted-period">.</span></h1><p>Papers, preprints, presentations, and other scholarly work.</p></section><section class="shell content-section">{sorted.length ? years.map(year => <div class="publication-year"><h2>{year}</h2><div>{sorted.filter(item => item.year === year).map(item => <article class="publication-entry"><span class="pill">{item.type}</span><h3>{item.title}</h3><p>{item.authors}</p><p class="entry-meta">{item.venue}</p>{item.abstract && <details class="abstract"><summary>Read abstract</summary><p>{item.abstract}</p></details>}<div class="flex gap-5">{item.url && <a class="text-link" href={resolveLink(item.url)} target="_blank" rel="noopener noreferrer">Read paper <Icon name="external" size={16} /></a>}{item.code && <a class="text-link" href={resolveLink(item.code)} target="_blank" rel="noopener noreferrer">Code <Icon name="external" size={16} /></a>}</div></article>)}</div></div>) : <EmptyState title="Work will appear here." text="No publications are listed yet. This space will bring together scholarly work and links to read it." />}</section></Layout>
