---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';
import { local } from '../lib/paths';
const cvUrl = local(profile.cvFile);
---
<Layout title="Curriculum vitae">
  <div id="top"></div>
  <section class="shell page-heading">
    <div class="heading-with-action">
      <h1>Curriculum vitae</h1>
      <a class="button" href={cvUrl} download="Porter_Olson_CV.pdf">Download PDF <Icon name="download" size={18} /></a>
    </div>
  </section>
  <section class="shell cv-document" aria-label="CV document">
    <div class="cv-document-links">
      <a href={cvUrl} target="_blank" rel="noopener noreferrer">Open PDF in a new tab</a>
      <p>PDF · {profile.cvUpdated}</p>
    </div>
    <iframe class="cv-pdf" src={`${cvUrl}#view=FitH`} title="Porter Olson’s curriculum vitae (PDF)"></iframe>
  </section>
</Layout>
