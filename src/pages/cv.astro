---
import Layout from '../layouts/Layout.astro';
import EmptyState from '../components/EmptyState.astro';
import Icon from '../components/Icon.astro';
import { profile, education, experience, publications, awards } from '../data/profile';
import { local } from '../lib/paths';
const hasContent = education.length || experience.length || publications.length || awards.length || profile.skills.length;
---
<Layout title="Curriculum vitae"><div id="top"></div><section class="shell page-heading"><p class="eyebrow">THE ACADEMIC RECORD</p><div class="heading-with-action"><h1>Curriculum vitae<span class="muted-period">.</span></h1>{profile.cvFile && <a class="button button-dark" href={local(profile.cvFile)} download>Download PDF <Icon name="download" size={18} /></a>}{!profile.cvFile && hasContent && <button class="button button-dark print-cv" type="button">Save as PDF <Icon name="download" size={18} /></button>}</div><p>Education, experience, and academic contributions in one place.</p></section><section class="shell content-section">{hasContent ? <div class="cv-content"><div class="cv-identity"><h2>{profile.name}</h2><p>{profile.role}{profile.affiliation && ` · ${profile.affiliation}`}</p>{profile.email && <a href={`mailto:${profile.email}`}>{profile.email}</a>}</div>{education.length > 0 && <section class="cv-section"><h2>Education</h2><div>{education.map(item => <article><span class="entry-meta">{item.period}</span><h3>{item.degree}</h3><p>{item.institution}</p>{item.detail && <p>{item.detail}</p>}</article>)}</div></section>}{experience.length > 0 && <section class="cv-section"><h2>Experience</h2><div>{experience.map(item => <article><span class="entry-meta">{item.period} · {item.category}</span><h3>{item.title}</h3><p>{item.organization}</p><p>{item.description}</p></article>)}</div></section>}{publications.length > 0 && <section class="cv-section"><h2>Publications</h2><div>{[...publications].sort((a,b) => b.year - a.year).map(item => <article><span class="entry-meta">{item.year}</span><h3>{item.title}</h3><p>{item.authors} · {item.venue}</p></article>)}</div></section>}{awards.length > 0 && <section class="cv-section"><h2>Honors & awards</h2><div>{awards.map(item => <article><span class="entry-meta">{item.year}</span><h3>{item.title}</h3><p>{item.organization}</p></article>)}</div></section>}{profile.skills.length > 0 && <section class="cv-section"><h2>Skills</h2><div class="flex flex-wrap gap-2">{profile.skills.map(skill => <span class="pill">{skill}</span>)}</div></section>}</div> : <EmptyState title="A fuller picture, coming soon." text="The academic record and downloadable CV will be available here once they’re added." />}{!profile.cvFile && hasContent && <p class="small-copy mt-10 print-note">Use “Save as PDF” to print this page or save a copy of the web CV.</p>}</section><script>
  document.addEventListener('astro:page-load', () => {
    document.querySelector('.print-cv')?.addEventListener('click', () => window.print());
  });
</script></Layout>
