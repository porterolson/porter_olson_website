---
import Layout from '../layouts/Layout.astro';
import EmptyState from '../components/EmptyState.astro';
import Icon from '../components/Icon.astro';
import { profile, research } from '../data/profile';
import { local, resolveLink } from '../lib/paths';
---
<Layout title="Research"><div id="top"></div><section class="shell page-heading"><p class="eyebrow">QUESTIONS & EXPLORATION</p><h1>Research<span class="muted-period">.</span></h1><p>A closer look at my interests, projects, and work in progress.</p></section><section class="shell content-section">{profile.interests.length > 0 && <div class="interest-band"><h2 class="eyebrow">RESEARCH INTERESTS</h2><div class="flex flex-wrap gap-2">{profile.interests.map(interest => <span class="pill">{interest}</span>)}</div></div>}{research.length ? <div class="project-list">{research.map((project, index) => <article class="project-entry"><span class="card-index">{String(index + 1).padStart(2, '0')}</span><div><span class="entry-meta">{project.status}</span><h2>{project.title}</h2><p>{project.summary}</p><div class="flex flex-wrap gap-2 mt-5">{project.tags.map(tag => <span class="pill">{tag}</span>)}</div>{project.url && <a class="text-link" href={resolveLink(project.url)} target="_blank" rel="noopener noreferrer">Explore project <Icon name="external" /></a>}</div></article>)}</div> : <EmptyState title="Questions taking shape." text="Research interests and project details will be shared here as this portfolio develops." />}<div class="page-next"><p>Interested in the broader picture?</p><a class="text-link" href={local('about/')}>Get to know my background <Icon /></a></div></section></Layout>
