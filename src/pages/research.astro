---
import Layout from '../layouts/Layout.astro';
import EmptyState from '../components/EmptyState.astro';
import { profile, research } from '../data/profile';
import { resolveLink } from '../lib/paths';
---
<Layout title="Research">
  <div id="top"></div>
  <section class="shell page-heading"><h1>Research</h1></section>
  <section class="shell content-section">
    {profile.interests.length > 0 && <div class="interest-band"><h2>Interests</h2><ul class="interest-list">{profile.interests.map(interest => <li>{interest}</li>)}</ul></div>}
    {research.length ? <div class="project-list">{research.map(project => <article class="project-entry"><div><h2>{project.title}</h2><p class="entry-meta project-status">{project.status}</p><p>{project.summary}</p>{project.url && <a class="text-link" href={resolveLink(project.url)} target="_blank" rel="noopener noreferrer">Paper (PDF)</a>}</div></article>)}</div> : <EmptyState title="Research" text="Project details will be added here." />}
  </section>
</Layout>
